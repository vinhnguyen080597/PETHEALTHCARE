# Local web: yarn dev → http://localhost:3001
#
# IMPORTANT: NEXT_PUBLIC_API_ORIGIN must be the Pet Health Express API,
# not another Next.js app. If something else already owns :3000 (e.g. MarketiFlow),
# either stop it / move backend to another PORT, or point at Render:
NEXT_PUBLIC_API_ORIGIN=https://pet-health-backend-serb.onrender.com
# NEXT_PUBLIC_API_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3001
NEXT_PUBLIC_IOS_APP_STORE_URL=https://apps.apple.com/app/id6778684107
NEXT_PUBLIC_IOS_APP_STORE_ID=6778684107

# Supabase Auth (required for Google / Facebook login on web)
# Use the same project as pet-health-backend (public anon key only).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Production (Vercel → pet-marketplace.org) — set in Vercel dashboard, do not commit secrets:
# NEXT_PUBLIC_API_ORIGIN=https://pet-health-backend-serb.onrender.com
# NEXT_PUBLIC_SITE_ORIGIN=https://pet-marketplace.org
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# NEXT_PUBLIC_IOS_APP_STORE_URL=https://apps.apple.com/app/id6778684107
# NEXT_PUBLIC_IOS_APP_STORE_ID=6778684107
#
# Also on Render backend:
# CORS_ORIGINS=https://pet-marketplace.org,https://www.pet-marketplace.org
# PUBLIC_SITE_ORIGIN=https://pet-marketplace.org
#
# Supabase Dashboard → Authentication → URL Configuration:
# - Site URL: https://pet-marketplace.org
# - Redirect URLs allowlist:
#   http://localhost:3001/api/auth/oauth/callback
#   https://pet-marketplace.org/api/auth/oauth/callback
# Enable Providers → Google and Facebook (App ID / secret from provider consoles).
# Google Cloud authorized redirect URI must be:
#   https://<project-ref>.supabase.co/auth/v1/callback
# Facebook Valid OAuth Redirect URIs must include the same Supabase callback URL.
